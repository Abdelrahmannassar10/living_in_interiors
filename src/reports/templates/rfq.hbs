<!doctype html><html><head><meta charset="utf-8"><style>body{font-family:Arial,sans-serif;color:#222}header{border-bottom:2px solid #222;padding-bottom:16px}table{width:100%;border-collapse:collapse;margin-top:20px}th,td{border-bottom:1px solid #ddd;padding:8px;text-align:left}th{background:#f3f3f3}.info{margin-top:16px}.info p{margin:4px 0}</style></head><body><header><h1>Living In Interiors</h1><p>Request for Quotation</p></header><h2>{{rfqNo}}</h2><div class="info"><p><strong>Date:</strong> {{rfqDate}}</p>{{#if supplier}}<p><strong>Supplier:</strong> {{supplier.name}}</p>{{/if}}{{#if clientName}}<p><strong>Client:</strong> {{clientName}}</p>{{/if}}{{#if contactPerson}}<p><strong>Contact:</strong> {{contactPerson}}</p>{{/if}}{{#if validUntil}}<p><strong>Valid Until:</strong> {{validUntil}}</p>{{/if}}{{#if notes}}<p><strong>Notes:</strong> {{notes}}</p>{{/if}}</div><table><thead><tr><th>#</th><th>Code</th><th>Description</th><th>Qty</th><th>Additional Notes</th></tr></thead><tbody>{{#each lines}}<tr><td>{{sortOrder}}</td><td>{{codeSnapshot}}</td><td>{{descriptionSnapshot}}</td><td>{{qty}}</td><td>{{description}}</td></tr>{{/each}}</tbody></table><p style="margin-top:24px"><strong>Status:</strong> {{status}} | <strong>Currency:</strong> {{currency}}</p></body></html>
