<!doctype html><html><head><meta charset="utf-8"><style>body{font-family:Arial,sans-serif;color:#222}header{border-bottom:2px solid #222;padding-bottom:16px}table{width:100%;border-collapse:collapse;margin-top:20px}th,td{border-bottom:1px solid #ddd;padding:8px;text-align:left}th{background:#f3f3f3}.totals{margin-left:auto;width:280px}</style></head><body><header><h1>Living In interiors</h1><p>Luxury furniture quotation</p></header><h2>{{quoteNo}}</h2><p>Date: {{quoteDate}} | Client: {{clientName}} | Project: {{projectName}}</p><table><thead><tr><th>Code</th><th>Description</th><th>Qty</th><th>Unit Price</th><th>Total</th></tr></thead><tbody>{{#each details}}<tr><td>{{codeSnapshot}}</td><td>{{descriptionSnapshot}}</td><td>{{qty}}</td><td>{{unitPrice}}</td><td>{{totalPriceAfterDiscount}}</td></tr>{{/each}}</tbody></table><section class="totals"><p>Subtotal: {{totals.subtotal}} {{currency}}</p><p>Grand Total: <strong>{{totals.grandTotal}} {{currency}}</strong></p></section></body></html>