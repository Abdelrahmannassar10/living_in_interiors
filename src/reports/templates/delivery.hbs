<!doctype html><html><head><meta charset="utf-8"><style>body{font-family:Arial,sans-serif;color:#222}header{border-bottom:2px solid #222;padding-bottom:16px}table{width:100%;border-collapse:collapse;margin-top:20px}th,td{border-bottom:1px solid #ddd;padding:8px;text-align:left}th{background:#f3f3f3}</style></head><body><header><h1>Living In interiors</h1><p>Delivery note</p></header><h2>{{deliveryNo}}</h2><p>Order: {{orderNo}} | Delivered: {{deliveredAt}}{{#if clientName}} | Client: {{clientName}}{{/if}}</p>{{#if notes}}<p>Notes: {{notes}}</p>{{/if}}<table><thead><tr><th>Code</th><th>Description</th><th>Qty</th></tr></thead><tbody>{{#each lines}}<tr><td>{{codeSnapshot}}</td><td>{{descriptionSnapshot}}</td><td>{{qty}}</td></tr>{{else}}<tr><td colspan="3" style="color:#888">No lines</td></tr>{{/each}}</tbody></table></body></html>