NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Living In interiors
CORS_ALLOW_ALL=true
ALLOWED_ORIGINS=*

DB_HOST=localhost
DB_PORT=5432
DB_NAME=living_in_interiors
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_ACCESS_SECRET=replace_with_a_long_access_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_refresh_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RESEND_API_KEY=re_your_api_key
# Use either a plain verified email or: Living In interiors <quotations@your-verified-domain.com>
RESEND_FROM_EMAIL=quotations@your-verified-domain.com
RESEND_FROM_NAME=Living In interiors

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=living-in-interiors

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

PUPPETEER_EXECUTABLE_PATH=
STOCK_ALERT_DEFAULT_THRESHOLD=1
STOCK_ALERT_EMAIL=