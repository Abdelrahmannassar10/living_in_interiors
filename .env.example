NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Living In interiors

# CORS — default is deny. Set explicit origins, or CORS_ALLOW_ALL=true only for local development.
CORS_ALLOW_ALL=false
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=living_in_interiors
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_LOGGING=false

JWT_ACCESS_SECRET=replace_with_a_long_access_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_refresh_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Optional: fixed password for the seeded admin (min 8 chars, letter + digit).
# If omitted, a strong random password is generated and printed once by `pnpm seed`.
SEED_ADMIN_PASSWORD=

RESEND_API_KEY=re_your_api_key
# Use either a plain verified email or: Living In interiors <quotations@your-verified-domain.com>
RESEND_FROM_EMAIL=quotations@your-verified-domain.com
RESEND_FROM_NAME=Living In interiors

# Recipient of the daily low-stock digest email (07:00 cron). Omit to disable the digest.
DIGEST_RECIPIENT_EMAIL=ops@your-verified-domain.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=living-in-interiors

PUPPETEER_EXECUTABLE_PATH=
